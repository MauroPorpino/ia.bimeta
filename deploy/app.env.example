# Segredos DA APLICACAO (Api e Worker). Modelo SEM valores reais: o scripts/gerar-segredos.sh o copia para "app.env" (permissao 600) e gera as chaves.
# O "app.env" NUNCA vai para o repositorio. Cada chave abaixo e Base64 de 32 bytes (openssl rand -base64 32).
#
# ATENCAO: guarde uma COPIA destas chaves FORA da maquina (cofre ou gerenciador de senhas). Perder a chave dos anexos e perder os arquivos cifrados;
# perder a das credenciais dos canais e perder o token do WhatsApp e os segredos da Meta cadastrados (tem de cadastrar de novo).
# Para trocar de chave: crie a nova (por exemplo "ch2"), aponte ActiveKeyId para ela e MANTENHA a antiga na lista (as antigas so decifram).

# Credenciais dos canais (token e segredos da Meta), cifradas no banco. As MESMAS no Api e no Worker.
Channels__Secrets__ActiveKeyId=ch1
Channels__Secrets__Keys__ch1=

# Chave BYOK da IA de cada empresa, cifrada no banco.
AiGateway__Secrets__ActiveKeyId=ai1
AiGateway__Secrets__Keys__ai1=

# Arquivos de midia em repouso (AES-256-GCM, chave derivada por empresa).
Conversations__Attachments__Encryption__ActiveKeyId=an1
Conversations__Attachments__Encryption__Keys__an1=

# Chave mestra do hash das lacunas do FAQ (Knowledge Engine; so o Worker usa; nao troque a toa: a de cada empresa sai dela).
Agents__Options__KnowledgeGapHashKey=
