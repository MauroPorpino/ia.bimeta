# Segredos DA APLICACAO (Api e Worker). Modelo SEM valores reais: o scripts/gerar-segredos.sh o copia para "app.env" (permissao 600) e gera as chaves.
# O "app.env" NUNCA vai para o repositorio. Cada chave abaixo e Base64 de 32 bytes (openssl rand -base64 32).
#
# ATENCAO: guarde uma COPIA destas chaves FORA da maquina (cofre ou gerenciador de senhas). Perder a chave dos anexos e perder os arquivos cifrados;
# perder a das credenciais dos canais e perder o token do WhatsApp e os segredos da Meta cadastrados (tem de cadastrar de novo).
# Para trocar de chave: crie a nova (por exemplo "ch2"), aponte ActiveKeyId para ela e MANTENHA a antiga na lista (as antigas so decifram).

# Credenciais dos canais (token e segredos da Meta), cifradas no banco. As MESMAS no Api e no Worker.
Channels__Secrets__ActiveKeyId=ch1
Channels__Secrets__Keys__ch1=

# Chave BYOK da IA de cada empresa, cifrada no banco.
AiGateway__Secrets__ActiveKeyId=ai1
AiGateway__Secrets__Keys__ai1=

# Segredos das CONEXOES do Motor de Integracao Empresarial (ADR 0035: API key, senha, client secret de cada ERP), cifrados no banco. Chaves PROPRIAS do modulo: nao reuse as do Channels nem as da IA.
# Perder esta chave e perder as credenciais cadastradas das integracoes (tem de cadastrar de novo). Sem ela, gravar uma credencial responde 503 e nenhuma conexao com autenticacao executa.
Capabilities__Secrets__ActiveKeyId=cp1
Capabilities__Secrets__Keys__cp1=

# Politica de DESTINO das chamadas de saida das integracoes: decisao do OPERADOR, nunca do cliente. O padrao (nada aqui) so alcanca enderecos PUBLICOS por https na porta 443.
# Para um ERP em rede interna (VPN), libere o CIDR exato dele. Metadados de nuvem e link-local nunca sao liberaveis. Descomente so o que for necessario:
# Capabilities__Options__Outbound__AllowedPrivateCidrs__0=10.20.0.0/16
# Capabilities__Options__Outbound__AllowedPorts__0=443
# Capabilities__Options__Outbound__AllowedPorts__1=8443
# Capabilities__Options__PerConnectionPerMinute=60
# Capabilities__Options__WritesPerTenantPerMinute=30

# Arquivos de midia em repouso (AES-256-GCM, chave derivada por empresa).
Conversations__Attachments__Encryption__ActiveKeyId=an1
Conversations__Attachments__Encryption__Keys__an1=

# Token do servico de IA local quando ele roda em OUTRA maquina atras do proxy autenticado (deploy/ollama/). Vazio com o servico na mesma rede do Compose.
Knowledge__Providers__Ollama__BearerToken=

# Chave mestra do hash das lacunas do FAQ (Knowledge Engine; so o Worker usa; nao troque a toa: a de cada empresa sai dela).
Agents__Options__KnowledgeGapHashKey=

# Consulta do agente de IA ao Motor de Integracao (ADR 0036). DESLIGADA por padrao. Para ligar: cadastre e publique as operacoes PUBLICAS de leitura, libere-as ao agente (classe do dado Public) e defina:
# Agents__Options__IntegrationLookupsEnabled=true
# Agents__Options__LookupBudget=00:00:08
# Com a consulta ligada o turno pode fazer duas chamadas ao modelo: TurnMaxDuration precisa passar o dobro de ModelCallTimeout mais LookupBudget (a partida recusa a configuracao se nao passar). Por exemplo:
# Agents__Options__ModelCallTimeout=00:00:30
# O Worker usa as mesmas chaves Capabilities__Secrets e a mesma politica Capabilities__Options__Outbound acima (ele e quem chama o ERP no turno).
