# Configuracao do BACKUP e dos ALERTAS. So os scripts do host leem este arquivo (nenhum contêiner o ve). Modelo SEM valores reais:
# o scripts/gerar-segredos.sh o copia para "backup.env" (permissao 600) e gera a frase. O "backup.env" NUNCA vai para o repositorio.

# Frase de cifra do backup (gpg simetrico, AES-256). Gerada. GUARDE UMA COPIA FORA DA MAQUINA: sem ela nenhum backup pode ser restaurado.
BACKUP_PASSPHRASE=

# Pasta dos backups cifrados nesta maquina e quantos DIAS manter aqui.
BACKUP_DIR=/var/backups/iabimeta
BACKUP_KEEP_DAYS=14

# Copia EXTERNA (obrigatoria no piloto: o disco da VM nao e um backup). Dois formatos:
#   usuario@servidor:/pasta     (rsync por SSH; a chave SSH do usuario que roda o backup deve estar autorizada no servidor)
#   /mnt/destino                (um disco ou compartilhamento ja montado; precisa ser OUTRO disco, nao a mesma VM)
BACKUP_EXTERNAL_DEST=

# Alertas: se preenchido, uma falha (backup, status critico, backup atrasado, disco cheio) faz um POST JSON {"text": "..."} nesta URL
# (um webhook de chat, por exemplo). Sempre ha tambem o arquivo de alertas em BACKUP_DIR/alertas.log.
ALERT_WEBHOOK_URL=
# Alerta se o ultimo backup bom for mais velho que isto (horas) e se o disco passar deste percentual de uso.
ALERT_BACKUP_MAX_AGE_HOURS=30
ALERT_DISK_PERCENT=85
