# Variaveis do PROPRIO Compose (dominio, senhas do banco, versoes). Modelo SEM valores reais.
# Nao edite este arquivo: o scripts/gerar-segredos.sh o copia para ".env" (permissao 600), gera as senhas e pede o dominio.
# O ".env" NUNCA vai para o repositorio.

# Dominio publico do atendimento (o DNS A deste nome aponta para o IP publico fixo) e e-mail do certificado (avisos do Let's Encrypt).
DOMAIN=
ACME_EMAIL=
# Autoridade do certificado. Padrao: producao. Para TESTAR o dominio sem estourar o limite do Let's Encrypt, use o ambiente de homologacao dele:
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# Senha do superusuario do PostgreSQL (so o backup e a manutencao usam) e do papel da aplicacao. Geradas; use so letras e numeros.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Versao das imagens do ia.bimeta (a tag que o atualizar.sh grava) e do verificador ClamAV (LTS 1.4).
IABIMETA_VERSAO=local
CLAMAV_IMAGE=clamav/clamav:1.4_base-debian13-slim

# Rede entre o proxy e o Api. Sub-rede FIXA (o Api so confia nos cabecalhos de encaminhamento dela). Mude se colidir com a sua rede local.
EDGE_SUBNET=172.29.89.0/24
EDGE_WEB_IP=172.29.89.2
