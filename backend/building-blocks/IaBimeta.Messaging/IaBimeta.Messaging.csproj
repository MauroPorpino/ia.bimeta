    <InternalsVisibleTo Include="IaBimeta.IntegrationTests" />
    <InternalsVisibleTo Include="IaBimeta.Messaging.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mesmas versões das Infrastructure dos módulos: a mecânica de filas roda dentro delas (BOUNDARIES.md §12.1). -->
