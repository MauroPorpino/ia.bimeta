<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Os testes de integração exercitam a cifra das credenciais (adulteração, outro tenant, rotação de chave) direto no componente. -->
  <ItemGroup>
    <InternalsVisibleTo Include="IaBimeta.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Mesmas versões do Tenancy: o EF Core de execução fica alinhado ao Design e ao dotnet-ef. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\building-blocks\IaBimeta.SharedKernel\IaBimeta.SharedKernel.csproj" />
    <ProjectReference Include="..\IaBimeta.Channels.Contracts\IaBimeta.Channels.Contracts.csproj" />
    <ProjectReference Include="..\IaBimeta.Channels.Core\IaBimeta.Channels.Core.csproj" />
  </ItemGroup>

</Project>
